// arm-mission-initial-state.nddl
// T0 = 2025-07-26 03:56:25 UTC. TLE-computed windows, minimal set.

#include "PlannerConfig.nddl"
#include "arm-mission-model.nddl"

PlannerConfig world = new PlannerConfig(0, 48000, 5000);

CommWindow   commState = new CommWindow();
OcclusionSWA occSWA    = new OcclusionSWA();
Arm          arm       = new Arm(commState, occSWA);

close();

// ═══ Comm (TLE-computed, merged early windows into one block) ═══
// Phase1a in [0,2060], Phase2 in [4590,8120] — merge as one visible block
fact(commState.InComms  c01); eq(c01.start, 0);     eq(c01.end, 8120);
fact(commState.OutComms g01); eq(g01.start, 8120);  eq(g01.end, 34420);
// Vis7 [34420,37710] — Phase3, occ blocks Phase4
fact(commState.InComms  c02); eq(c02.start, 34420); eq(c02.end, 37710);
fact(commState.OutComms g02); eq(g02.start, 37710); eq(g02.end, 40240);
// Vis8 [40240,43570] — Phase4+5+6
fact(commState.InComms  c03); eq(c03.start, 40240); eq(c03.end, 43570);
fact(commState.OutComms g03); eq(g03.start, 43570); eq(g03.end, 48000);

// ═══ SWA Occlusion (TLE-computed, beam=5deg) ═══
fact(occSWA.Inactive o01); eq(o01.start, 0);     eq(o01.end, 36770);
fact(occSWA.Active   o02); eq(o02.start, 36770); eq(o02.end, 37200);
fact(occSWA.Inactive o03); eq(o03.start, 37200); eq(o03.end, 48000);

// ═══ Facts ═══
fact(arm.BigArmRestart p1a);   eq(p1a.start, 0);     eq(p1a.duration, 980);
fact(arm.SmallArmRestart p1b); eq(p1b.start, 2060);   eq(p1b.duration, 150);
fact(arm.Phase2Settings p2);   eq(p2.start, 4590);    eq(p2.duration, 3530);
fact(arm.WaitForMotion waitP); eq(waitP.start, 8120);  eq(waitP.end, 34420);
fact(arm.Phase3 p3);           eq(p3.start, 34420);   eq(p3.duration, 1840);
fact(arm.IdleOcc idle);        eq(idle.start, 36260);  eq(idle.end, 40240);

// ═══ Goal ═══
goal(arm.Done missionGoal);
leq(1, missionGoal.start);
leq(missionGoal.end, 48000);
