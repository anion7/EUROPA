// arm-mission-model.nddl  (TLE-computed real occlusion scenario)
// Phase3 needs comm. Occlusion at [36770,37200] blocks Phase4 in Vis7.
// Phase4+5+6 must go to Vis8 [40240,43570].

class CommWindow extends Timeline {
    predicate InComms  {}
    predicate OutComms {}
}

class OcclusionSWA extends Timeline {
    predicate Active   {}
    predicate Inactive {}
}

class Arm extends Timeline {
    CommWindow     comm;
    OcclusionSWA   occlusion;

    predicate BigArmRestart   {}
    predicate SmallArmRestart {}
    predicate Phase2Settings  {}
    predicate WaitForMotion   {}

    action Phase3  {}   // 1840s
    predicate IdleOcc {}  // wait: occ + comm gap

    action Phase4  {}   // 770s [occ]
    action Phase5  {}   // 460s [occ]
    action Phase6  {}   // 1560s
    predicate Done {}

    Arm(CommWindow _c, OcclusionSWA _o) {
        comm = _c; occlusion = _o;
    }
}

Arm::Phase3 {
    eq(duration, 1840);
    contained_by(condition object.comm.InComms);
}

Arm::Phase4 {
    eq(duration, 770);
    met_by(condition object.IdleOcc);
    contained_by(condition object.comm.InComms);
    contained_by(condition object.occlusion.Inactive);
}

Arm::Phase5 {
    eq(duration, 460);
    met_by(condition object.Phase4);
    contained_by(condition object.comm.InComms);
    contained_by(condition object.occlusion.Inactive);
}

Arm::Phase6 {
    eq(duration, 1560);
    met_by(condition object.Phase5);
    contained_by(condition object.comm.InComms);
    meets(effect object.Done);
}
