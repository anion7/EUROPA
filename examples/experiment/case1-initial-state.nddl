// Case 1: No occ. Solver handles Phase3→4→5 chain + Phase6.
#include "PlannerConfig.nddl"
#include "case1-model.nddl"
PlannerConfig world = new PlannerConfig(0, 66000, 5000);
CommWindow cs = new CommWindow(); OcclusionSWA os = new OcclusionSWA();
Arm arm = new Arm(cs, os); close();

// Comm (relevant windows only)
fact(cs.InComms  c01); eq(c01.start, 0);     eq(c01.end, 9490);
fact(cs.OutComms g01); eq(g01.start, 9490);  eq(g01.end, 35550);
fact(cs.InComms  c02); eq(c02.start, 35550); eq(c02.end, 39060);
fact(cs.OutComms g02); eq(g02.start, 39060); eq(g02.end, 41610);
fact(cs.InComms  c03); eq(c03.start, 41610); eq(c03.end, 45090);
fact(cs.OutComms g03); eq(g03.start, 45090); eq(g03.end, 47640);
fact(cs.InComms  c04); eq(c04.start, 47640); eq(c04.end, 51010);
fact(cs.OutComms g04); eq(g04.start, 51010); eq(g04.end, 53560);
fact(cs.InComms  c05); eq(c05.start, 53560); eq(c05.end, 56850);
fact(cs.OutComms g05); eq(g05.start, 56850); eq(g05.end, 59430);
fact(cs.InComms  c06); eq(c06.start, 59430); eq(c06.end, 62870);
fact(cs.OutComms g06); eq(g06.start, 62870); eq(g06.end, 66000);

// No occ
fact(os.Inactive o01); eq(o01.start, 0); eq(o01.end, 66000);

// Pre-placed facts
fact(arm.BigArmRestart p1a); eq(p1a.start, 6130); eq(p1a.duration, 980);
fact(arm.SmallArmRestart p1b); eq(p1b.start, 37250); eq(p1b.duration, 150);
fact(arm.WaitP2 wp2); eq(wp2.start, 37400); eq(wp2.end, 41610);
fact(arm.Phase2A p2a); eq(p2a.start, 41610); eq(p2a.duration, 3370);
fact(arm.Phase2B p2b); eq(p2b.start, 47640); eq(p2b.duration, 160);
fact(arm.WaitP3 wp3); eq(wp3.start, 47800); eq(wp3.end, 53560);
// Two goals: Phase5 (forces Phase3→4→5 chain) and Done (forces Phase6)
goal(arm.Phase5 g5); leq(53560, g5.start); leq(g5.end, 56850);
goal(arm.Done gd);   leq(59430, gd.start); leq(gd.end, 66000);
